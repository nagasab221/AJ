# ─── Copy this file to .env.local and fill it in. Never commit .env.local. ───

# Public site URL (used for canonical links + Stripe return URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Supabase (Project Settings → API) ───────────────────────────────────────
# The service-role key is server-only. It must never appear in NEXT_PUBLIC_*.
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ─── Admin panel ─────────────────────────────────────────────────────────────
# The single password AJ types at /admin.
ADMIN_PASSWORD=change-me-to-something-long
# Random string used to sign the admin session cookie.
# Generate one with:  node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
ADMIN_SESSION_SECRET=

# ─── Telegram booking notifications (optional) ───────────────────────────────
# Create a bot with @BotFather, then send it /start from the chat that should
# receive alerts and read the chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Stripe (optional — deposits, Apple Pay & Google Pay) ────────────────────
# Use test keys (sk_test_… / pk_test_…) during development.
# When these are empty the site simply hides the "pay now" option and every
# booking is recorded as "pay at the shop".
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# From: Stripe dashboard → Developers → Webhooks → your endpoint → signing secret
STRIPE_WEBHOOK_SECRET=
