# @opennextjs/cloudflare 1.20.1 declares a peer range of Next 15, but this
# project runs Next 14 (the build passes --dangerouslyUseUnsupportedNextVersion
# for the same reason). Without this, a plain `npm ci` fails with ERESOLVE.
#
# It lives here rather than in a CI setting because Cloudflare Workers Builds
# runs its own install step with no way to pass flags to it.
legacy-peer-deps=true
